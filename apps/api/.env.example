NODE_ENV=development
PORT=3001
# Comma-separated — the API is shared between planazo_fronted and planazo_cms.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# SQLite local (via libsql) mientras el schema multi-sitio sigue en diseño — cero
# servicio externo, cero costo. "file:./data/dev.sqlite" es relativo a apps/api.
# Migrar a Postgres/Supabase más adelante es cambiar esta URL a una postgresql://
# y el dialect en drizzle.config.ts — no toca la lógica de los servicios.
DATABASE_URL=file:./data/dev.sqlite

# Optional, added once caching is needed
REDIS_URL=redis://localhost:6379

# Signs CMS session cookies — generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-random-32-byte-hex-string

# Only used by `pnpm db:seed` to create the first CMS admin account, if none exists yet
SEED_ADMIN_EMAIL=admin@planazo.mx
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Admin

# Powers /cms/ai/generate-place — https://platform.openai.com/api-keys
OPENAI_API_KEY=
