# Copia este archivo a .env y llena los valores.
# YOUTUBE_API_KEY: Google Cloud Console > APIs y servicios > Credenciales > Crear
# credenciales > Clave de API. Habilita antes "YouTube Data API v3" en la Biblioteca.
# Gratis dentro de la cuota diaria (10,000 unidades/día). Sin esto, la sección de
# YouTube simplemente no aparece en los reportes.
YOUTUBE_API_KEY=

# Presupuesto propio (unidades/día) por debajo de la cuota gratis de Google, para
# cortar las llamadas ANTES de acercarse al límite. Opcional, default 8000.
YOUTUBE_DAILY_UNIT_BUDGET=8000

# BING_WEBMASTER_API_KEY: bing.com/webmasters > (sitio verificado) > perfil > API
# Access. Gratis, pero requiere verificar un dominio propio (ej. lamira.mx) en Bing
# Webmaster Tools primero. Da volumen de búsqueda REAL semanal (no una estimación).
# Sin esto, esa sección simplemente no aparece.
BING_WEBMASTER_API_KEY=

# TMDB_API_KEY: themoviedb.org > cuenta > Configuración > API > Create > API Key
# (v3 auth). Gratis, autoservicio, sin aprobación manual. Alimenta la categoría
# "Cine y TV" con lo trending de la semana. Sin esto, esa sección simplemente no aparece.
TMDB_API_KEY=
