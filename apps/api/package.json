    "db:find-photos-for-places": "ts-node -r tsconfig-paths/register src/db/find-photos-for-places.ts",
    "db:dedupe-lamira-content-round2": "ts-node -r tsconfig-paths/register src/db/dedupe-lamira-content-round2.ts",
    "db:delete-misclassified-round2": "ts-node -r tsconfig-paths/register src/db/delete-misclassified-round2.ts",
    "db:delete-old-test-places": "ts-node -r tsconfig-paths/register src/db/delete-old-test-places.ts",
    "db:delete-unconfirmed-places": "ts-node -r tsconfig-paths/register src/db/delete-unconfirmed-places.ts",
    "db:audit-content-quality": "ts-node -r tsconfig-paths/register src/db/audit-content-quality.ts",
    "db:delete-bad-events": "ts-node -r tsconfig-paths/register src/db/delete-bad-events.ts",
    "db:expand-short-lamira-content": "ts-node -r tsconfig-paths/register src/db/expand-short-lamira-content.ts",
    "db:delete-misclassified-round3": "ts-node -r tsconfig-paths/register src/db/delete-misclassified-round3.ts",
    "db:dedupe-lamira-round3": "ts-node -r tsconfig-paths/register src/db/dedupe-lamira-round3.ts",
    "db:backfill-photo-alt": "ts-node -r tsconfig-paths/register src/db/backfill-photo-alt.ts",
    "db:delete-bad-events-round2": "ts-node -r tsconfig-paths/register src/db/delete-bad-events-round2.ts",
    "db:delete-bad-events-round3": "ts-node -r tsconfig-paths/register src/db/delete-bad-events-round3.ts",
