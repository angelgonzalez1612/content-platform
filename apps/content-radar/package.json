    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.0",
    "marked": "^18.0.10"
  }
}
