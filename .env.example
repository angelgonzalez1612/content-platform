NODE_ENV=development
PORT=3001
# Comma-separated — the API is shared between planazo_fronted and planazo_cms.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Postgres (Supabase project settings -> Database -> Connection string, use the pooled "Transaction" URL for the app
# and the direct connection URL for running migrations)
DATABASE_URL=postgresql://postgres:password@localhost:5432/planazo

# Optional, added once caching is needed
REDIS_URL=redis://localhost:6379

# Signs CMS session cookies — generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-random-32-byte-hex-string

# Only used by `pnpm db:seed` to create the first CMS admin account, if none exists yet
SEED_ADMIN_EMAIL=admin@planazo.mx
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Admin

# Powers /cms/ai/generate-place — https://platform.openai.com/api-keys
OPENAI_API_KEY=
