{
  "name": "@planazo/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "node -e \"if (!process.env.VERCEL) require('node:child_process').execSync('playwright install chromium', { stdio: 'inherit' })\"",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --webpack --watch",
    "start:dev": "nest start --webpack --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node -r tsconfig-paths/register src/db/seed.ts",
    "db:seed:places": "ts-node -r tsconfig-paths/register src/db/seed-places.ts",
    "db:seed:categories": "ts-node -r tsconfig-paths/register src/db/seed-categories.ts",
    "db:seed:locations": "ts-node -r tsconfig-paths/register src/db/seed-locations.ts",
    "db:migrate:lamira-mock": "ts-node -r tsconfig-paths/register src/db/migrate-lamira-mock.ts",
    "db:migrate:planazo-mock": "ts-node -r tsconfig-paths/register src/db/migrate-planazo-mock.ts",
    "db:migrate:planazo-events": "ts-node -r tsconfig-paths/register src/db/migrate-planazo-events.ts",
    "db:migrate:planazo-guides": "ts-node -r tsconfig-paths/register src/db/migrate-planazo-guides.ts",
    "db:apply-mejorar-lamira": "ts-node -r tsconfig-paths/register src/db/apply-mejorar-lamira.ts",
    "db:trim-seo-and-apply": "ts-node -r tsconfig-paths/register src/db/trim-seo-and-apply.ts",
    "db:dedupe-lamira-content": "ts-node -r tsconfig-paths/register src/db/dedupe-lamira-content.ts",
    "db:delete-test-place": "ts-node -r tsconfig-paths/register src/db/delete-test-place.ts",
    "db:delete-misclassified-places": "ts-node -r tsconfig-paths/register src/db/delete-misclassified-places.ts",
    "db:fix-place-photos": "ts-node -r tsconfig-paths/register src/db/fix-place-photos.ts",
